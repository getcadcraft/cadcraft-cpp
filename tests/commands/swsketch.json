[
 {
  "name": "SWBOUT: lines, a polyline with an arc, a circle, an arc, a point, relations, dimensions, equations",
  "steps": [
   "LINE",
   "0,0",
   "100,0",
   "",
   "LINE",
   "100,0",
   "100,60",
   "",
   "CIRCLE",
   "50,30",
   "10",
   "PLINE",
   "0,70",
   "40,70",
   "A",
   "40,90",
   "L",
   "0,90",
   "C",
   "ARC",
   "150,0",
   "170,20",
   "190,0",
   "POINT",
   "120,120",
   {
    "esc": true
   },
   "GCHORIZONTAL",
   {
    "click": [
     50,
     0
    ],
    "pick": 1
   },
   "GCPERPENDICULAR",
   {
    "click": [
     50,
     0
    ],
    "pick": 1
   },
   {
    "click": [
     100,
     30
    ],
    "pick": 2
   },
   "GCCOINCIDENT",
   {
    "click": [
     99,
     1
    ],
    "pick": 2
   },
   {
    "click": [
     99,
     0
    ],
    "pick": 1
   },
   "DCHORIZONTAL",
   {
    "click": [
     1,
     0
    ],
    "pick": 1
   },
   {
    "click": [
     99,
     0
    ],
    "pick": 1
   },
   "50,-10",
   "",
   "DCRADIUS",
   {
    "click": [
     60,
     30
    ],
    "pick": 3
   },
   "70,45",
   "r=d1/10",
   "GCHORIZONTAL",
   {
    "click": [
     20,
     70
    ],
    "pick": 4
   },
   "-PARAMETERS",
   "N",
   "width",
   "sqrt(d1^2+4)*2",
   "-PARAMETERS",
   "N",
   "half",
   "width % 3",
   "-PARAMETERS",
   "N",
   "big",
   "width > 10",
   "-PARAMETERS",
   "N",
   "cosy",
   "cos(pi/4)-atan(1)+min(1,2)",
   "SWBOUT"
  ]
 },
 {
