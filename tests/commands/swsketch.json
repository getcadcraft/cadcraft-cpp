      "type": "plane",
      "name": "Front"
     },
     {
      "type": "sketch",
      "name": "Sketch1",
      "plane": {
       "origin": [
        0,
        0,
        0
       ]
      },
      "points": [
       {
        "id": "p1",
        "x": 0,
        "y": 0
       },
       {
        "id": "p2",
        "x": 80,
        "y": 0
       },
       {
        "id": "p3",
        "x": 80,
        "y": 40
       },
       {
        "id": "c1",
        "x": 40,
        "y": 20
       },
       {
        "id": "a0",
        "x": 120,
        "y": 0
       },
       {
        "id": "as",
        "x": 140,
        "y": 0
       },
       {
        "id": "ae",
        "x": 120,
        "y": 20
       },
       {
        "id": "lone",
        "x": 10,
        "y": 50,
        "construction": true
       }
      ],
      "segments": [
       {
        "id": "L1",
        "type": "line",
        "a": "p1",
        "b": "p2"
       },
       {
        "id": "L2",
        "type": "line",
        "a": "p2",
        "b": "p3",
        "construction": true
       },
       {
        "id": "C1",
        "type": "circle",
        "c": "c1",
        "r": 8
       },
       {
        "id": "A1",
        "type": "arc",
        "c": "a0",
        "s": "as",
        "e": "ae"
       }
      ],
      "relations": [
       {
        "type": "horizontal",
        "refs": [
         "L1"
        ]
       },
       {
        "type": "vertical",
        "refs": [
         "L2"
        ]
       },
       {
        "type": "coincident",
        "refs": [
         "L1",
         "p1"
        ]
       },
       {
        "type": "midpoint",
        "refs": [
         "c1",
         "L1"
        ]
       },
       {
        "type": "smurf",
        "refs": [
         "L1"
        ]
       },
       {
        "type": "fix",
        "refs": [
         "C1"
        ]
       },
       {
        "type": "tangent",
        "refs": [
         "A1",
         "L1"
        ]
       },
       {
        "type": "coincident",
        "refs": [
         "p1",
         "O"
        ]
       }
      ],
      "dimensions": [
       {
        "type": "distance",
        "name": "D1",
        "full": "D1@Sketch1",
        "value": 80,
        "refs": [
         "L1"
        ]
       },
       {
        "type": "radius",
        "name": "D2",
        "value": 8,
        "refs": [
         "C1"
        ]
       },
       {
        "type": "angle",
        "name": "pi",
        "value": 90,
        "refs": [
         "L1",
         "L2"
        ]
       },
       {
        "type": "ordinate",
        "name": "D9",
        "value": 3,
        "refs": [
         "p1"
        ]
       },
       {
        "type": "vdistance",
        "name": "D1",
        "value": 40,
        "refs": [
         "p2",
         "p3"
        ]
       }
      ]
     },
     {
      "type": "sketch",
      "name": "Sketch2",
      "suppressed": true,
      "points": [
       {
        "id": "q",
        "x": 1,
        "y": 2
       }
      ]
     }
    ],
    "globals": [
     {
      "name": "Width",
      "expr": "\"D1@Sketch1\" * 2"
     },
     {
      "name": "bad name",
      "expr": "1"
     },
     {
      "name": "Other",
      "expr": "\"D7@Sketch9\" + 1"
     },
     {
      "name": "Root",
      "expr": "sqr(16) + SGN(-2) + atn(1)"
     },
     {
      "name": 5,
      "expr": "1"
     }
    ],
    "equations": [
     {
      "lhs": "\"D2@Sketch1\"",
      "rhs": "\"Width\" / 20"
     },
     {
      "lhs": "\"Width\"",
      "rhs": "1"
     },
     {
      "lhs": "\"D5@Sketch1\"",
      "rhs": "2"
     },
     {
      "lhs": "\"D1\"",
      "rhs": "\"nope@x\" + 1"
     },
     {
      "lhs": 3,
      "rhs": "1"
     }
    ]
   },
   "sketch": "Sketch1"
  },
  "steps": [
   "PARAMETERS"
  ]
