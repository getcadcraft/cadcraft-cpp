# cc_library / cc_executable / cc_test / cc_fuzz — the only ways a target enters the build.
#
# Every library has a LAYER (AGENTS.md section 5). A library may link only libraries of a strictly lower layer;
# configure fails otherwise. UI toolkits (SDL, ImGui, WebGPU/Dawn) may be linked only from layer 6 up. Apps are layer 7.
#
#   cc_library(base LAYER 0 SOURCES src/a.cpp DEPS cc::x EXTERNAL fmt::fmt)
#     → target cc_base, alias cc::base, public include dir <dir>/include
#   cc_executable(cadcraft-cli SOURCES main.cpp DEPS cc::base)          (layer 7)
#   cc_test(base SOURCES tests/reader.cpp DEPS cc::base)                 (Catch2; skipped when tests are off)
#   cc_fuzz(reader SOURCES fuzz_reader.cpp DEPS cc::base)                (libFuzzer; only with CC_FUZZ)
include_guard(GLOBAL)

set(CC_UI_TOOLKIT_PATTERN "SDL|imgui|ImGui|webgpu|dawn|Dawn|emdawnwebgpu")

function(_cc_check_deps target layer)
  foreach(dep IN LISTS ARGN)
    if(NOT dep MATCHES "^cc::")
      message(FATAL_ERROR "${target}: '${dep}' is not a cc:: library; list it under EXTERNAL")
    endif()
    string(REPLACE "cc::" "cc_" real "${dep}")
    if(NOT TARGET ${real})
      message(FATAL_ERROR "${target}: dependency ${dep} is not defined yet (add_subdirectory order follows the layers)")
    endif()
    get_target_property(dep_layer ${real} CC_LAYER)
    if(dep_layer STREQUAL "dep_layer-NOTFOUND")
      message(FATAL_ERROR "${target}: ${dep} has no layer")
    endif()
    if(NOT dep_layer LESS layer)
      message(FATAL_ERROR "Layer violation: ${target} (L${layer}) may not link ${dep} (L${dep_layer}); "
                          "a library links only strictly lower layers (AGENTS.md section 5)")
    endif()
  endforeach()
endfunction()

function(_cc_check_external target layer)
  foreach(ext IN LISTS ARGN)
    if(layer LESS 6 AND ext MATCHES "${CC_UI_TOOLKIT_PATTERN}")
      message(FATAL_ERROR "Layer violation: ${target} (L${layer}) may not link UI toolkit ${ext}; only L6+ may")
    endif()
  endforeach()
endfunction()

function(cc_library name)
  cmake_parse_arguments(A "HEADER_ONLY" "LAYER" "SOURCES;DEPS;EXTERNAL;PRIVATE_EXTERNAL" ${ARGN})
  if(NOT DEFINED A_LAYER OR NOT A_LAYER MATCHES "^[0-6]$")
    message(FATAL_ERROR "cc_library(${name}): LAYER 0..6 is required")
  endif()
  set(target cc_${name})
  _cc_check_deps(${target} ${A_LAYER} ${A_DEPS})
  _cc_check_external(${target} ${A_LAYER} ${A_EXTERNAL} ${A_PRIVATE_EXTERNAL})
  if(A_HEADER_ONLY)
    add_library(${target} INTERFACE)
    target_include_directories(${target} INTERFACE ${CMAKE_CURRENT_SOURCE_DIR}/include)
    target_link_libraries(${target} INTERFACE ${A_DEPS} ${A_EXTERNAL})
    target_compile_features(${target} INTERFACE cxx_std_23)
  else()
    add_library(${target} STATIC ${A_SOURCES})
    target_include_directories(${target} PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/include)
    target_link_libraries(${target} PUBLIC ${A_DEPS} ${A_EXTERNAL} PRIVATE ${A_PRIVATE_EXTERNAL})
    target_compile_features(${target} PUBLIC cxx_std_23)
    cc_apply_policy(${target})
  endif()
  set_target_properties(${target} PROPERTIES CC_LAYER ${A_LAYER})
  add_library(cc::${name} ALIAS ${target})
  set_property(GLOBAL APPEND PROPERTY CC_LIBRARIES "${target}|${A_LAYER}|${CMAKE_CURRENT_SOURCE_DIR}")
endfunction()

function(cc_executable name)
  cmake_parse_arguments(A "" "OUTPUT_NAME" "SOURCES;DEPS;EXTERNAL" ${ARGN})
  _cc_check_deps(${name} 7 ${A_DEPS})
  add_executable(${name} ${A_SOURCES})
  target_link_libraries(${name} PRIVATE ${A_DEPS} ${A_EXTERNAL})
  target_compile_features(${name} PRIVATE cxx_std_23)
  set_target_properties(${name} PROPERTIES CC_LAYER 7)
  if(A_OUTPUT_NAME)
    set_target_properties(${name} PROPERTIES OUTPUT_NAME ${A_OUTPUT_NAME})
  endif()
  cc_apply_policy(${name})
endfunction()

# Tests and fuzz targets sit outside the layer order (they may link anything) but follow the same flags.
function(cc_test name)
  if(NOT CC_BUILD_TESTS)
    return()
  endif()
  cmake_parse_arguments(A "" "" "SOURCES;DEPS;LABELS" ${ARGN})
  set(target test_${name})
  add_executable(${target} ${A_SOURCES})
  target_link_libraries(${target} PRIVATE ${A_DEPS} Catch2::Catch2WithMain)
  target_compile_features(${target} PRIVATE cxx_std_23)
  cc_apply_policy(${target})
  catch_discover_tests(${target} TEST_PREFIX "${name}." PROPERTIES LABELS "unit;${A_LABELS}"
                       DISCOVERY_MODE PRE_TEST)
endfunction()

function(cc_fuzz name)
  if(NOT CC_FUZZ)
    return()
  endif()
  cmake_parse_arguments(A "" "CORPUS" "SOURCES;DEPS" ${ARGN})
  set(target fuzz_${name})
  add_executable(${target} ${A_SOURCES})
  target_link_libraries(${target} PRIVATE ${A_DEPS})
  target_compile_features(${target} PRIVATE cxx_std_23)
  cc_apply_policy(${target})
  target_link_options(${target} PRIVATE -fsanitize=fuzzer)
  if(CC_HAVE_LIBCXX AND CMAKE_SYSTEM_NAME STREQUAL "Linux")
    # apt.llvm.org's libFuzzer runtime is built against libstdc++. Its interface is plain C, so the two standard
    # libraries never exchange objects; link libstdc++ beside libc++ for the runtime's own needs.
    # (By path: with -stdlib=libc++ the clang driver rewrites -lstdc++ to libc++.)
    find_file(CC_LIBSTDCXX_SO NAMES libstdc++.so.6 PATHS /usr/lib/x86_64-linux-gnu /usr/lib64 /usr/lib REQUIRED)
    target_link_options(${target} PRIVATE LINKER:--push-state,--no-as-needed ${CC_LIBSTDCXX_SO} LINKER:--pop-state)
  endif()
  set_property(GLOBAL APPEND PROPERTY CC_FUZZ_TARGETS "${target}|${A_CORPUS}")
endfunction()
