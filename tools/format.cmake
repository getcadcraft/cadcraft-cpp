cmake_minimum_required(VERSION 3.28)
# gate.format: clang-format --dry-run --Werror on every C++ source (cmake -DSRC=<repo> -P tools/format.cmake).
include(${CMAKE_CURRENT_LIST_DIR}/_sources.cmake)
find_program(CLANG_FORMAT NAMES clang-format-22 clang-format REQUIRED)
cc_list_sources(${SRC} files)
if(NOT files)
  message(STATUS "format: no sources")
  return()
endif()
execute_process(COMMAND ${CLANG_FORMAT} --dry-run --Werror ${files} WORKING_DIRECTORY ${SRC} RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "format: run clang-format -i on the files above")
endif()
list(LENGTH files n)
message(STATUS "format: ${n} files clean")
