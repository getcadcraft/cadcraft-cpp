cmake_minimum_required(VERSION 3.28)
# gate.assets: every file under assets/ has a row in ASSETS.md naming its path (AGENTS.md section 4, Assets).
file(GLOB_RECURSE files RELATIVE ${SRC} ${SRC}/assets/*)
file(READ ${SRC}/ASSETS.md table)
set(missing "")
foreach(f IN LISTS files)
  string(FIND "${table}" "`${f}`" at)
  if(at EQUAL -1)
    list(APPEND missing ${f})
  endif()
endforeach()
if(missing)
  list(JOIN missing "\n  " msg)
  message(FATAL_ERROR "assets: no row in ASSETS.md for:\n  ${msg}")
endif()
list(LENGTH files n)
message(STATUS "assets: ${n} files listed")
