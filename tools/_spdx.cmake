# Reads vcpkg's per-port SBOM (share/<port>/vcpkg.spdx.json). Sets <prefix>_LICENSE (the port's SPDX licence
# expression) and <prefix>_UPSTREAM ("https://github.com/o/r@ref", or "").
function(cc_read_spdx file prefix)
  file(READ ${file} json)
  string(JSON n LENGTH "${json}" packages)
  set(lic "")
  set(up "")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    string(JSON name GET "${json}" packages ${i} name)
    string(JSON loc ERROR_VARIABLE e GET "${json}" packages ${i} downloadLocation)
    string(JSON concl ERROR_VARIABLE e GET "${json}" packages ${i} licenseConcluded)
    if(i EQUAL 0)
      set(lic "${concl}")
    endif()
    if(NOT loc MATCHES "microsoft/vcpkg" AND loc MATCHES "^git\\+(https://github\\.com/[^@]+)@(.+)$")
      set(up "${CMAKE_MATCH_1}@${CMAKE_MATCH_2}")
    endif()
  endforeach()
  set(${prefix}_LICENSE "${lic}" PARENT_SCOPE)
  set(${prefix}_UPSTREAM "${up}" PARENT_SCOPE)
endfunction()
