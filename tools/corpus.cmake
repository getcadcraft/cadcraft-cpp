# Test files never live in this repo (AGENTS.md section 4, Assets).
#
#   cmake -DDEST=<dir> -P tools/corpus.cmake
#     fetches the public fixtures listed in tools/corpus-public.txt from github.com/getcadcraft/cadcraft at the
#     pinned commit into <dir>, each checked against its SHA-256 (files already there and correct are kept).
#   cmake -DLOCAL=<dir> -P tools/corpus.cmake
#     checks a local corpus folder exists (the private corpus, /var/www/CADCRAFT/testfiles on the build server,
#     whose file names stay out of this public repo) and counts its DWG files.
if(DEFINED LOCAL)
  if(NOT IS_DIRECTORY ${LOCAL})
    message(FATAL_ERROR "corpus: ${LOCAL} is not a folder")
  endif()
  file(GLOB_RECURSE dwgs ${LOCAL}/*.dwg ${LOCAL}/*.DWG)
  list(LENGTH dwgs n)
  message(STATUS "corpus: ${n} DWG files under ${LOCAL}")
  return()
endif()
if(NOT DEFINED DEST)
  message(FATAL_ERROR "corpus: pass -DDEST=<dir> or -DLOCAL=<dir>")
endif()
file(STRINGS ${CMAKE_CURRENT_LIST_DIR}/corpus-public.txt lines)
set(commit "")
foreach(l IN LISTS lines)
  if(l MATCHES "^# commit ([0-9a-f]+)")
    set(commit ${CMAKE_MATCH_1})
  endif()
endforeach()
if(commit STREQUAL "")
  message(FATAL_ERROR "corpus: no commit in corpus-public.txt")
endif()
set(n 0)
foreach(l IN LISTS lines)
  if(l MATCHES "^#" OR l STREQUAL "")
    continue()
  endif()
  string(REGEX MATCH "^([0-9a-f]+) (.+)$" _m "${l}")
  set(sha ${CMAKE_MATCH_1})
  set(path ${CMAKE_MATCH_2})
  set(out ${DEST}/${path})
  if(EXISTS ${out})
    file(SHA256 ${out} have)
    if(have STREQUAL sha)
      math(EXPR n "${n} + 1")
      continue()
    endif()
  endif()
  file(DOWNLOAD https://raw.githubusercontent.com/getcadcraft/cadcraft/${commit}/${path} ${out}
       EXPECTED_HASH SHA256=${sha} STATUS st TLS_VERIFY ON)
  list(GET st 0 code)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "corpus: ${path}: ${st}")
  endif()
  math(EXPR n "${n} + 1")
endforeach()
message(STATUS "corpus: ${n} public fixtures in ${DEST} (commit ${commit})")
