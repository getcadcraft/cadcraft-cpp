cmake_minimum_required(VERSION 3.28)
# The web build's deploy folder with content-hashed names (name-<12 hex>.ext), which the test host serves immutable
# for a year; index.html (never cached long) points at them. Run by the web-dist target:
#   cmake -DBUILD=<apps/cadcraft-web build dir> -DOUT=<folder> [-DSAMPLE=<drawing for ?sample>] -P tools/web-dist.cmake
foreach(v BUILD OUT)
  if(NOT DEFINED ${v})
    message(FATAL_ERROR "web-dist: -D${v}=… is required")
  endif()
endforeach()
file(REMOVE_RECURSE ${OUT})
file(MAKE_DIRECTORY ${OUT})

function(hashed src stem ext out_var)  # copy src as <stem>-<hash>.<ext>; the new name in out_var
  file(SHA256 ${src} h)
  string(SUBSTRING ${h} 0 12 h)
  set(name ${stem}-${h}.${ext})
  configure_file(${src} ${OUT}/${name} COPYONLY)
  set(${out_var} ${name} PARENT_SCOPE)
endfunction()

hashed(${BUILD}/cadcraft-web.wasm cadcraft-web wasm wasm_name)
hashed(${BUILD}/cadcraft-web.data cadcraft-web data data_name)
hashed(${BUILD}/cadcraft.css cadcraft css css_name)
# the script loads the two by their quoted names: point them at the hashed ones, then hash the script itself
file(READ ${BUILD}/cadcraft-web.js js)
foreach(pair "cadcraft-web.wasm|${wasm_name}" "cadcraft-web.data|${data_name}")
  string(REPLACE "|" ";" p "${pair}")
  list(GET p 0 from)
  list(GET p 1 to)
  string(FIND "${js}" "\"${from}\"" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "web-dist: \"${from}\" not found in cadcraft-web.js (Emscripten changed how it names files)")
  endif()
  string(REPLACE "\"${from}\"" "\"${to}\"" js "${js}")
endforeach()
file(WRITE ${OUT}/cadcraft-web.js.tmp "${js}")
hashed(${OUT}/cadcraft-web.js.tmp cadcraft-web js js_name)
file(REMOVE ${OUT}/cadcraft-web.js.tmp)
file(READ ${BUILD}/index.html html)
string(REPLACE "href=\"cadcraft.css\"" "href=\"${css_name}\"" html "${html}")
string(REPLACE "src=\"cadcraft-web.js\"" "src=\"${js_name}\"" html "${html}")
file(WRITE ${OUT}/index.html "${html}")
if(DEFINED SAMPLE AND EXISTS ${SAMPLE})
  file(MAKE_DIRECTORY ${OUT}/samples)
  configure_file(${SAMPLE} ${OUT}/samples/kitchen-equipment.dxf COPYONLY)
endif()
message(STATUS "web-dist: ${OUT}: index.html, ${js_name}, ${wasm_name}, ${data_name}, ${css_name}")
