cmake_minimum_required(VERSION 3.28)
# gate.layers: no library below layer 6 includes a UI toolkit header (SDL, ImGui, WebGPU/Dawn). The dependency
# order itself is checked by cc_library() at configure time. (cmake -DSRC=<repo> -P tools/layers.cmake)
file(GLOB lib_lists ${SRC}/libs/*/CMakeLists.txt)
set(bad "")
foreach(f IN LISTS lib_lists)
  file(READ ${f} text)
  string(REGEX MATCHALL "cc_library\\([A-Za-z0-9_-]+[ \n\t]+LAYER[ \n\t]+[0-9]" decls "${text}")
  foreach(d IN LISTS decls)
    string(REGEX REPLACE ".*LAYER[ \n\t]+([0-9])" "\\1" layer "${d}")
    if(layer LESS 6)
      get_filename_component(dir ${f} DIRECTORY)
      file(GLOB_RECURSE srcs ${dir}/*.cpp ${dir}/*.hpp ${dir}/*.h)
      foreach(s IN LISTS srcs)
        file(STRINGS ${s} hits REGEX "^[ \t]*#[ \t]*include[ \t]*[<\"](SDL[0-9]*/|imgui|webgpu/|dawn/|emscripten/html5_webgpu)")
        if(hits)
          string(REPLACE "${SRC}/" "" rel ${s})
          list(APPEND bad "${rel} (L${layer}): ${hits}")
        endif()
      endforeach()
    endif()
  endforeach()
endforeach()
if(bad)
  list(JOIN bad "\n  " msg)
  message(FATAL_ERROR "layers: UI toolkit headers below layer 6:\n  ${msg}")
endif()
list(LENGTH lib_lists n)
message(STATUS "layers: ${n} libraries checked")
