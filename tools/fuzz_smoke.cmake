cmake_minimum_required(VERSION 3.28)
# gate.fuzz-smoke: each libFuzzer target runs on a copy of its corpus for CC_FUZZ_SECONDS (default 30) seconds,
# CC_FUZZ_JOBS targets at a time (default half the logical cores, at most 8), one process each.
# cmake -DSRC=<repo> -DFUZZ_BUILD=<fuzz preset build dir> -P tools/fuzz_smoke.cmake
if(DEFINED ENV{CC_FUZZ_SECONDS})
  set(secs $ENV{CC_FUZZ_SECONDS})
else()
  set(secs 30)
endif()
if(DEFINED ENV{CC_FUZZ_JOBS})
  set(jobs $ENV{CC_FUZZ_JOBS})
else()
  cmake_host_system_information(RESULT cores QUERY NUMBER_OF_LOGICAL_CORES)
  math(EXPR jobs "${cores} / 2")
  if(jobs GREATER 8)
    set(jobs 8)
  endif()
endif()
if(jobs LESS 1)
  set(jobs 1)
endif()
file(GLOB targets ${FUZZ_BUILD}/fuzz/fuzz_*)
list(FILTER targets EXCLUDE REGEX "\\.(cmake|txt)$|CMakeFiles")
if(NOT targets)
  message(FATAL_ERROR "fuzz-smoke: no fuzz targets in ${FUZZ_BUILD}/fuzz (run the fuzz preset first)")
endif()

# each target's work folder: a copy of its corpus (and the public seeds its .seeds file names), an artifacts folder
foreach(t IN LISTS targets)
  get_filename_component(name ${t} NAME)
  string(REGEX REPLACE "^fuzz_" "" short ${name})
  set(work ${FUZZ_BUILD}/smoke/${short})
  file(REMOVE_RECURSE ${work})
  file(MAKE_DIRECTORY ${work}/corpus ${work}/artifacts)
  if(EXISTS ${SRC}/fuzz/corpus/${short})
    file(COPY ${SRC}/fuzz/corpus/${short}/ DESTINATION ${work}/corpus)
  endif()
  # Seeds fetched by tools/corpus.cmake (public fixtures, never committed): fuzz/corpus/<name>.seeds lists them.
  if(EXISTS ${SRC}/fuzz/corpus/${short}.seeds)
    if(NOT EXISTS ${SRC}/build/corpus)
      execute_process(COMMAND ${CMAKE_COMMAND} -DDEST=${SRC}/build/corpus -P ${SRC}/tools/corpus.cmake)
    endif()
    file(STRINGS ${SRC}/fuzz/corpus/${short}.seeds seeds REGEX "^[^#]")
    foreach(sd IN LISTS seeds)
      if(EXISTS ${SRC}/build/corpus/${sd})
        file(COPY ${SRC}/build/corpus/${sd} DESTINATION ${work}/corpus)
      endif()
    endforeach()
  endif()
endforeach()

# batches of `jobs` targets at once: execute_process runs its COMMANDs side by side; each writes its own log
message(STATUS "fuzz-smoke: ${secs} s per target, ${jobs} at a time")
set(failed "")
list(LENGTH targets n)
set(i 0)
while(i LESS n)
  set(cmds "")
  set(batch "")
  set(k 0)
  while(k LESS jobs AND i LESS n)
    list(GET targets ${i} t)
    get_filename_component(name ${t} NAME)
    string(REGEX REPLACE "^fuzz_" "" short ${name})
    set(work ${FUZZ_BUILD}/smoke/${short})
    list(APPEND cmds COMMAND sh -c "exec '${t}' '${work}/corpus' -max_total_time=${secs} -timeout=10 -rss_limit_mb=2048 -artifact_prefix='${work}/artifacts/' -print_final_stats=1 > '${work}/log' 2>&1")
    list(APPEND batch ${short})
    math(EXPR i "${i} + 1")
    math(EXPR k "${k} + 1")
  endwhile()
  execute_process(${cmds} RESULTS_VARIABLE rcs)
  set(j 0)
  foreach(short IN LISTS batch)
    list(GET rcs ${j} rc)
    math(EXPR j "${j} + 1")
    file(READ ${FUZZ_BUILD}/smoke/${short}/log err)
    string(REGEX MATCH "stat::number_of_executed_units: *[0-9]+" runs "${err}")
    message(STATUS "fuzz-smoke: ${short}: ${runs}")
    if(NOT rc EQUAL 0)
      message(SEND_ERROR "fuzz-smoke: ${short} failed (artifacts in ${FUZZ_BUILD}/smoke/${short}/artifacts)\n${err}")
      list(APPEND failed ${short})
    endif()
  endforeach()
endwhile()
if(failed)
  message(FATAL_ERROR "fuzz-smoke: failed: ${failed}")
endif()
