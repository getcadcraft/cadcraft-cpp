# gate.fuzz-smoke: each libFuzzer target runs on a copy of its corpus for CC_FUZZ_SECONDS (default 30) seconds.
# cmake -DSRC=<repo> -DFUZZ_BUILD=<fuzz preset build dir> -P tools/fuzz_smoke.cmake
if(DEFINED ENV{CC_FUZZ_SECONDS})
  set(secs $ENV{CC_FUZZ_SECONDS})
else()
  set(secs 30)
endif()
file(GLOB targets ${FUZZ_BUILD}/fuzz/fuzz_*)
list(FILTER targets EXCLUDE REGEX "\\.(cmake|txt)$|CMakeFiles")
if(NOT targets)
  message(FATAL_ERROR "fuzz-smoke: no fuzz targets in ${FUZZ_BUILD}/fuzz (run the fuzz preset first)")
endif()
foreach(t IN LISTS targets)
  get_filename_component(name ${t} NAME)
  string(REGEX REPLACE "^fuzz_" "" short ${name})
  set(work ${FUZZ_BUILD}/smoke/${short})
  file(REMOVE_RECURSE ${work})
  file(MAKE_DIRECTORY ${work}/corpus ${work}/artifacts)
  if(EXISTS ${SRC}/fuzz/corpus/${short})
    file(COPY ${SRC}/fuzz/corpus/${short}/ DESTINATION ${work}/corpus)
  endif()
  message(STATUS "fuzz-smoke: ${short} for ${secs} s")
  execute_process(COMMAND ${t} ${work}/corpus -max_total_time=${secs} -timeout=10 -rss_limit_mb=2048
                          -artifact_prefix=${work}/artifacts/ -print_final_stats=1
                  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  string(REGEX MATCH "stat::number_of_executed_units: *[0-9]+" runs "${err}")
  message(STATUS "fuzz-smoke: ${short}: ${runs}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "fuzz-smoke: ${short} failed (artifacts in ${work}/artifacts)\n${err}")
  endif()
endforeach()
