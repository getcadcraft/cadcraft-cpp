# gate.identity: every commit is authored and committed as CadCraft and carries no assistant attribution
# (AGENTS.md section 15, Identity).
find_package(Git QUIET)
if(NOT GIT_FOUND OR NOT EXISTS "${SRC}/.git")
  message(STATUS "identity: not a git checkout")
  return()
endif()
execute_process(COMMAND ${GIT_EXECUTABLE} log --format=%an%x09%ae%x09%cn%x09%ce WORKING_DIRECTORY ${SRC}
                OUTPUT_VARIABLE ids OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE rc ERROR_QUIET)
if(NOT rc EQUAL 0 OR ids STREQUAL "")
  message(STATUS "identity: no commits yet")
  return()
endif()
string(REPLACE "\n" ";" ids "${ids}")
list(REMOVE_DUPLICATES ids)
foreach(i IN LISTS ids)
  if(NOT i STREQUAL "CadCraft\tddgconsultant@getcadcraft.com\tCadCraft\tddgconsultant@getcadcraft.com"
     AND NOT i MATCHES "\tGitHub\tnoreply@github.com$")
    message(FATAL_ERROR "identity: a commit is not authored as CadCraft <ddgconsultant@getcadcraft.com>: ${i}")
  endif()
endforeach()
execute_process(COMMAND ${GIT_EXECUTABLE} log --format=%B WORKING_DIRECTORY ${SRC} OUTPUT_VARIABLE bodies)
string(TOLOWER "${bodies}" lower)
foreach(word "co-authored-by" "generated with")
  string(FIND "${lower}" "${word}" at)
  if(NOT at EQUAL -1)
    message(FATAL_ERROR "identity: a commit message carries \"${word}\"")
  endif()
endforeach()
message(STATUS "identity: commits clean")
