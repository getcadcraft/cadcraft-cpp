cmake_minimum_required(VERSION 3.28)
# gate.licenses: every installed port's licence is on the allowlist (AGENTS.md section 3). The licence comes from
# vcpkg's SBOM (the port's declared SPDX expression); a port without one fails until it is checked by hand and
# added to KNOWN below with the reason.  cmake -DINSTALLED=<vcpkg_installed/<triplet>> -P tools/licenses.cmake
include(${CMAKE_CURRENT_LIST_DIR}/_spdx.cmake)
set(ALLOW MIT Apache-2.0 "Apache-2.0 WITH LLVM-exception" BSD-2-Clause BSD-3-Clause ISC Zlib BSL-1.0 FTL OFL-1.1
    Unicode-3.0 Unicode-DFS-2016 CC0-1.0 Unlicense)
# port → licence checked by hand (port declares none or a non-SPDX text). Keep the reason in THIRD_PARTY.md.
set(KNOWN "")
file(GLOB sboms ${INSTALLED}/share/*/vcpkg.spdx.json)
set(bad "")
set(count 0)
foreach(f IN LISTS sboms)
  get_filename_component(dir ${f} DIRECTORY)
  get_filename_component(port ${dir} NAME)
  if(port MATCHES "^vcpkg-")
    continue()   # vcpkg's own build helpers: never linked
  endif()
  math(EXPR count "${count} + 1")
  cc_read_spdx(${f} P)
  set(expr "${P_LICENSE}")
  foreach(k IN LISTS KNOWN)
    if(k MATCHES "^${port}=(.*)$")
      set(expr "${CMAKE_MATCH_1}")
    endif()
  endforeach()
  if(expr STREQUAL "" OR expr STREQUAL "NOASSERTION")
    list(APPEND bad "${port}: no licence declared")
    continue()
  endif()
  # An OR alternative passes when every AND part is allowed; the expression passes when one alternative does.
  string(REPLACE "(" "" e "${expr}")
  string(REPLACE ")" "" e "${e}")
  string(REPLACE " OR " ";" alts "${e}")
  set(ok OFF)
  foreach(a IN LISTS alts)
    string(REPLACE " AND " ";" parts "${a}")
    set(all ON)
    foreach(p IN LISTS parts)
      string(STRIP "${p}" p)
      if(NOT p IN_LIST ALLOW)
        set(all OFF)
      endif()
    endforeach()
    if(all)
      set(ok ON)
    endif()
  endforeach()
  if(ok)
    message(STATUS "licenses: ${port}: ${expr}")
  else()
    list(APPEND bad "${port}: ${expr}")
  endif()
endforeach()
if(bad)
  list(JOIN bad "\n  " msg)
  message(FATAL_ERROR "licenses: not on the allowlist:\n  ${msg}")
endif()
message(STATUS "licenses: ${count} ports allowed")
