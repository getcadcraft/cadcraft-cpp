# gate.osv: known vulnerabilities in the dependencies. osv-scanner cannot read vcpkg manifests or vcpkg's SBOM
# (its purls are pkg:vcpkg, which OSV does not index), so this asks the same database, api.osv.dev, by each port's
# upstream repository and tag (ecosystem GIT). A hit fails the gate unless docs/security-waivers.md names the id.
# Offline runs: set CC_OSV_OFFLINE=1 to skip with a warning (never in CI).
# cmake -DSRC=<repo> -DINSTALLED=<vcpkg_installed/<triplet>> -P tools/osv.cmake
include(${CMAKE_CURRENT_LIST_DIR}/_spdx.cmake)
if(DEFINED ENV{CC_OSV_OFFLINE})
  message(WARNING "osv: skipped (CC_OSV_OFFLINE)")
  return()
endif()
find_program(CURL curl REQUIRED)
set(waivers "")
if(EXISTS ${SRC}/docs/security-waivers.md)
  file(READ ${SRC}/docs/security-waivers.md waivers)
endif()
file(GLOB sboms ${INSTALLED}/share/*/vcpkg.spdx.json)
set(hits "")
set(n 0)
foreach(f IN LISTS sboms)
  get_filename_component(dir ${f} DIRECTORY)
  get_filename_component(port ${dir} NAME)
  if(port MATCHES "^vcpkg-")
    continue()
  endif()
  cc_read_spdx(${f} P)
  if(P_UPSTREAM STREQUAL "")
    message(STATUS "osv: ${port}: no upstream git reference in its SBOM, not checked")
    continue()
  endif()
  if(NOT P_UPSTREAM MATCHES "^([^@]+)@(.+)$")
    message(FATAL_ERROR "osv: ${port}: cannot read ${P_UPSTREAM}")
  endif()
  set(repo "${CMAKE_MATCH_1}")
  set(ref "${CMAKE_MATCH_2}")
  execute_process(COMMAND ${CURL} -sS --fail --max-time 30 https://api.osv.dev/v1/query
                          -d "{\"package\":{\"name\":\"${repo}\",\"ecosystem\":\"GIT\"},\"version\":\"${ref}\"}"
                  OUTPUT_VARIABLE out RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "osv: api.osv.dev did not answer for ${port}")
  endif()
  math(EXPR n "${n} + 1")
  string(JSON nv ERROR_VARIABLE e LENGTH "${out}" vulns)
  if(nv AND nv GREATER 0)
    math(EXPR last "${nv} - 1")
    foreach(i RANGE ${last})
      string(JSON id GET "${out}" vulns ${i} id)
      string(FIND "${waivers}" "${id}" at)
      if(at EQUAL -1)
        list(APPEND hits "${port} ${ref}: ${id}")
      else()
        message(STATUS "osv: ${port}: ${id} waived")
      endif()
    endforeach()
  else()
    message(STATUS "osv: ${port} ${ref}: no known vulnerabilities")
  endif()
endforeach()
if(hits)
  list(JOIN hits "\n  " msg)
  message(FATAL_ERROR "osv: known vulnerabilities (fix, or waive in docs/security-waivers.md with a reason and date):\n  ${msg}")
endif()
message(STATUS "osv: ${n} ports checked")
