cmake_minimum_required(VERSION 3.28)
# gate.tidy: clang-tidy (config in .clang-tidy) on the files changed against origin/main, or on every file when
# CC_TIDY_ALL is set or there is no base to compare with (nightly runs the whole tree).
# cmake -DSRC=<repo> -DBUILD=<build dir with compile_commands.json> -P tools/tidy.cmake
include(${CMAKE_CURRENT_LIST_DIR}/_sources.cmake)
find_program(RUN_TIDY NAMES run-clang-tidy-22 run-clang-tidy REQUIRED)
find_program(CLANG_TIDY NAMES clang-tidy-22 clang-tidy REQUIRED)
set(files "")
find_package(Git QUIET)
if(NOT DEFINED ENV{CC_TIDY_ALL} AND GIT_FOUND AND EXISTS "${SRC}/.git")
  # CC_TIDY_BASE: the commit to compare with (CI passes the push's "before" commit); else origin/main.
  if(DEFINED ENV{CC_TIDY_BASE} AND NOT "$ENV{CC_TIDY_BASE}" MATCHES "^0+$")
    set(against $ENV{CC_TIDY_BASE})
  else()
    set(against origin/main)
  endif()
  execute_process(COMMAND ${GIT_EXECUTABLE} merge-base HEAD ${against} WORKING_DIRECTORY ${SRC}
                  OUTPUT_VARIABLE base OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE rc ERROR_QUIET)
  if(rc EQUAL 0)
    execute_process(COMMAND ${GIT_EXECUTABLE} diff --name-only --diff-filter=ACMR ${base} -- "*.cpp"
                    WORKING_DIRECTORY ${SRC} OUTPUT_VARIABLE changed OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(changed)
      string(REPLACE "\n" ";" files "${changed}")
    else()
      message(STATUS "tidy: no C++ file changed against origin/main")
      return()
    endif()
  endif()
endif()
if(NOT files)
  cc_list_sources(${SRC} files)
  list(FILTER files INCLUDE REGEX "\\.cpp$")
endif()
set(abs "")
foreach(f IN LISTS files)
  list(APPEND abs "${SRC}/${f}")
endforeach()
cmake_host_system_information(RESULT ncpu QUERY NUMBER_OF_LOGICAL_CORES)
execute_process(COMMAND ${RUN_TIDY} -clang-tidy-binary ${CLANG_TIDY} -p ${BUILD} -quiet -j ${ncpu} ${abs}
                RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "tidy: clang-tidy found problems")
endif()
list(LENGTH abs n)
message(STATUS "tidy: ${n} files clean")
